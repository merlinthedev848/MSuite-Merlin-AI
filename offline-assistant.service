[Unit]
Description=Merlin AI Offline Personal Assistant & Coder
After=network.target

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/offline-ai-assistant
ExecStart=/home/pi/offline-ai-assistant/venv/bin/python server.py
Restart=always
RestartSec=5
Environment=HOST=0.0.0.0
Environment=PORT=5000
Environment=PYTHONUNBUFFERED=1
Environment=N_CTX=8192

[Install]
WantedBy=multi-user.target
