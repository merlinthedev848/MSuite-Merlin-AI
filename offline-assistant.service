[Unit]
Description=Merlin AI Offline Personal Assistant & Coder
After=network.target

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/merlin-ai
ExecStart=/home/pi/merlin-ai/venv/bin/python main.py
Restart=always
RestartSec=5
Environment=HOST=0.0.0.0
Environment=PORT=5000
Environment=PYTHONUNBUFFERED=1
LimitNOFILE=65535
Environment=N_CTX=4096
Environment=CONTEXT_BUDGET=1500
Environment=MAX_TOKENS=1024

[Install]
WantedBy=multi-user.target
