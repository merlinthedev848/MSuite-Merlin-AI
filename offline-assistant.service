[Unit]
Description=Merlin AI High-Performance Native Linux Daemon
After=network.target

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/merlin-ai
ExecStart=/home/pi/merlin-ai/merlin-server
Restart=always
RestartSec=3
Environment=HOST=0.0.0.0
Environment=PORT=5000
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
